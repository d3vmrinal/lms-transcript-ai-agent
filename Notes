## CURRENT CLASSIFIER CODE

def classify_content(title):

```
t = title.lower()

if any(x in t for x in [
    "quiz",
    "assessment",
    "mcq",
    "cla",
    "questions",
]):
    return "QUIZ"

if any(x in t for x in [
    "discussion",
    "forum",
    "instructions",
]):
    return "FORUM"

if any(x in t for x in [
    "handout",
    "pdf",
    "slides",
    "notes",
    "pre-read",
    "pre-reads",
    "reading",
]):
    return "HANDOUT"

if any(x in t for x in [
    "game",
    "match",
    "activity",
    "exercise",
    "interlude",
]):
    return "ACTIVITY"

if "welcome" in t:
    return "INTRO"

return "VIDEO"
```

